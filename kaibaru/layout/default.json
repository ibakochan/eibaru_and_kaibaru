    "9": {
      "id": 9,
      "order": 9,
      "title": "よくある質問",
      "slug": "よくある質問",
      "type": "custom",
      "icon": "info",
      "layout": {
        "version": 2,
        "boxes": [
          {
            "id": "35b6a8e8-665b-568b-b223-874d4217ad0f",
            "x": 50,
            "y": 20,
            "width": 1100,
            "height": 99,
            "order": 1,
            "content": [
              {
                "type": "heading",
                "level": 2,
                "children": [
                  {
                    "text": "よくある質問"
                  }
                ],
                "align": "center"
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "ご入会前によくいただくご質問です。",
                    "fontSize": 18
                  }
                ],
                "align": "center"
              }
            ]
          },
          {
            "id": "542f8e34-425f-5b2e-816e-4c82814958fd",
            "x": 50,
            "y": 148.1,
            "width": 520,
            "height": 119,
            "order": 2,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Q. 初心者でも参加できますか？"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "A. はい、もちろんです。経験のない方も多数ご参加いただいています。",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "27ae54f0-72f0-5dec-893f-ffcdee0657eb",
            "x": 630,
            "y": 148.1,
            "width": 520,
            "height": 119,
            "order": 3,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Q. 体験はできますか？"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "A. 体験は随時受け付けています。スケジュールから体験予約ができます。",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "bdf7e42d-e7e6-5de1-87dc-b554c09c5f63",
            "x": 50,
            "y": 296.884,
            "width": 520,
            "height": 119,
            "order": 4,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Q. 持ち物は何が必要ですか？"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "A. 動きやすい服装と飲み物をお持ちください。（変更してください）",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "a2997b37-7697-5501-a438-a16d124a9ab2",
            "x": 630,
            "y": 296.884,
            "width": 520,
            "height": 119,
            "order": 5,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Q. 退会はいつでもできますか？"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "A. はい、いつでもお手続きいただけます。詳しくはスタッフまでお尋ねください。",
                    "fontSize": 18
                  }
                ]
              }
            ]
          }
        ]
      }
    },
