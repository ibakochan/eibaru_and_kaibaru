    "4": {
      "id": 4,
      "order": 5,
      "title": "Why here",
      "slug": "why-here",
      "type": "custom",
      "icon": "award",
      "layout": {
        "version": 2,
        "boxes": [
          {
            "id": "52cd8840-3d81-507d-aff3-92f0deced0f1",
            "x": 50,
            "y": 20,
            "width": 1100,
            "height": 99,
            "order": 1,
            "content": [
              {
                "type": "heading",
                "level": 2,
                "children": [
                  {
                    "text": "Why here"
                  }
                ],
                "align": "center"
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "Three reasons people stay",
                    "fontSize": 18
                  }
                ],
                "align": "center"
              }
            ]
          },
          {
            "id": "e8ff983d-5e05-5e74-94cc-c494fa3288e4",
            "x": 50,
            "y": 148.1,
            "width": 340,
            "height": 179,
            "order": 2,
            "content": [
              {
                "type": "block",
                "paragraphSize": 0.2,
                "children": [
                  {
                    "text": "POINT 01",
                    "fontSize": 16,
                    "bold": true
                  }
                ],
                "align": "center"
              },
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Fine if you're new"
                  }
                ],
                "align": "center"
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "We start from the basics. A first visit should still feel like the thing itself, not a lecture.",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "3ad0fd6d-8489-530c-9478-1e54a9fa1f94",
            "x": 430,
            "y": 148.1,
            "width": 340,
            "height": 179,
            "order": 3,
            "content": [
              {
                "type": "block",
                "paragraphSize": 0.2,
                "children": [
                  {
                    "text": "POINT 02",
                    "fontSize": 16,
                    "bold": true
                  }
                ],
                "align": "center"
              },
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Times you can actually keep"
                  }
                ],
                "align": "center"
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "Evenings in the week, and weekends, so it can sit next to a normal life.",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "cc11376e-9607-51d1-a71a-d072f4c4c55d",
            "x": 810,
            "y": 148.1,
            "width": 340,
            "height": 179,
            "order": 4,
            "content": [
              {
                "type": "block",
                "paragraphSize": 0.2,
                "children": [
                  {
                    "text": "POINT 03",
                    "fontSize": 16,
                    "bold": true
                  }
                ],
                "align": "center"
              },
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "A room that feels friendly"
                  }
                ],
                "align": "center"
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "People know each other. That's what makes it easier to come back.",
                    "fontSize": 18
                  }
                ]
              }
            ]
          }
        ]
      }
    },
