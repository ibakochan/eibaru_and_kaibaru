                "align": "center"
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "Questions people ask before they join.",
                    "fontSize": 18
                  }
                ],
                "align": "center"
              }
            ]
          },
          {
            "id": "542f8e34-425f-5b2e-816e-4c82814958fd",
            "x": 50,
            "y": 148.1,
            "width": 520,
            "height": 119,
            "order": 2,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Can I come if I've never done this?"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "Yes. A lot of the people here started with no experience.",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "27ae54f0-72f0-5dec-893f-ffcdee0657eb",
            "x": 630,
            "y": 148.1,
            "width": 520,
            "height": 119,
            "order": 3,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Can I try a class first?"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "Yes. Book an intro from the schedule.",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "bdf7e42d-e7e6-5de1-87dc-b554c09c5f63",
            "x": 50,
            "y": 296.884,
            "width": 520,
            "height": 119,
            "order": 4,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "What should I bring?"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "Clothes you can move in, and water. Replace this with what you actually need.",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "a2997b37-7697-5501-a438-a16d124a9ab2",
            "x": 630,
            "y": 296.884,
            "width": 520,
            "height": 119,
            "order": 5,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Can I cancel whenever I want?"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "Yes. Ask the desk how the notice period works.",
                    "fontSize": 18
                  }
                ]
              }
            ]
          }
        ]
      }
    },
