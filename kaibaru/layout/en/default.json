          {
            "id": "26302129-1854-5545-b8b8-def777030d21",
            "x": 590,
            "y": 20,
            "width": 560,
            "height": 66,
            "order": 3,
            "content": [
              {
                "type": "heading",
                "level": 2,
                "children": [
                  {
                    "text": "About the club"
                  }
                ]
              }
            ]
          },
          {
            "id": "2c485ba1-6990-544a-8890-a789f23000f7",
            "x": 590,
            "y": 99.80000000000001,
            "width": 560,
            "height": 172,
            "order": 4,
            "content": [
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "This is a club for getting healthier and for knowing the people you train with. Age and experience don't decide whether you can start.",
                    "fontSize": 18
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "Every line and photo on this page can be changed in the editor. Put the club's own story here.",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "07161ee8-1b00-5bed-82d9-91b34fff542b",
            "x": 590,
            "y": 285.3,
            "width": 560,
            "height": 148,
            "order": 5,
            "content": [
              {
                "type": "list",
                "ordered": false,
                "children": [
                  {
                    "type": "list-item",
                    "children": [
                      {
                        "text": "New and returning people are welcome",
                        "fontSize": 18
                      }
                    ]
                  },
                  {
                    "type": "list-item",
                    "children": [
                      {
                        "text": "Small groups, so the teaching can stay close",
                        "fontSize": 18
                      }
                    ]
                  },
                  {
                    "type": "list-item",
                    "children": [
                      {
                        "text": "Times that work after work",
                        "fontSize": 18
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "bb5c29aa-6194-515c-9b96-9d4fd13a953c",
