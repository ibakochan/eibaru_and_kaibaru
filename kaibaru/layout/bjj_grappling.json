      "title": "よくある質問",
      "slug": "よくある質問",
      "type": "custom",
      "icon": "info",
      "layout": {
        "version": 2,
        "boxes": [
          {
            "id": "1bdcb265-d3fd-554a-b38f-6d519f5129a8",
            "x": 50,
            "y": 20,
            "width": 1100,
            "height": 99,
            "order": 1,
            "content": [
              {
                "type": "heading",
                "level": 2,
