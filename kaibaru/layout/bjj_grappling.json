                  {
                    "text": "よくある質問"
                  }
                ],
                "align": "center"
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "ご入会前によくいただくご質問です。",
                    "fontSize": 18
                  }
                ],
                "align": "center"
              }
            ]
          },
          {
            "id": "ce17825b-0a45-5aeb-b1f2-e454c36e6e1e",
            "x": 50,
            "y": 148.1,
            "width": 520,
            "height": 87,
            "order": 2,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Q. 体力に自信がなくても大丈夫ですか？"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "A. はい。ご自身のペースで取り組めるよう指導します。",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "34ce03e1-66cd-53b9-bae5-9f14e364e4bc",
            "x": 630,
            "y": 148.1,
            "width": 520,
            "height": 119,
            "order": 3,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Q. 道着は必要ですか？"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "A. 体験ではレンタル可能です。ご入会後に購入をご案内します。（変更してください）",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "efb105ea-6806-54ef-8a0d-5ee86e8b6b07",
            "x": 50,
            "y": 296.884,
            "width": 520,
            "height": 87,
            "order": 4,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Q. ケガが心配です"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "A. 初心者クラスでは安全な練習を徹底しています。",
                    "fontSize": 18
                  }
                ]
              }
            ]
          },
          {
            "id": "f5a6ee9c-424e-5ee5-b560-b6290e224960",
            "x": 630,
            "y": 296.884,
            "width": 520,
            "height": 87,
            "order": 5,
            "content": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "Q. 女性・年配の方でも参加できますか？"
                  }
                ]
              },
              {
                "type": "block",
                "paragraphSize": 0.4,
                "children": [
                  {
                    "text": "A. はい。多くの女性・年配の会員様が練習しています。",
                    "fontSize": 18
                  }
                ]
              }
            ]
          }
        ]
      }
